{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["region", "secretArn", "roleArn"],
  "properties": {
    "region": {"type": "string", "minLength": 1},
    "secretArn": {"type": "string", "pattern": "^arn:aws:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+"},
    "roleArn": {"type": "string", "pattern": "^arn:aws:iam::[0-9]{12}:role/.+"}
  }
}
