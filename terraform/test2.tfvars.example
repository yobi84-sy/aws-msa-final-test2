# 실제 적용 전에 파일을 복사하고 이메일·관리자 ARN 등 기존 필수 입력을 채우세요.
# Git에 실제 tfvars/비밀번호를 커밋하지 않습니다.
manage_db_password = true
customer_email_sender = "verified-sender@example.com"
customer_email_test_recipients = ["verified-customer@example.com"]
# 기존 SES 인증 ID를 재사용. 전용 새 ID를 Terraform 소유로 만들 때만 true.
manage_ses_identities = false
# 발신자/샌드박스 수신자 인증 확인 전에는 false 유지.
customer_email_enabled = false

# NAT 자동 우회·복귀 기본 활성화: 별도 t3.nano 4대, SSM Endpoint 2종 등 추가 비용.
# 실제 AWS 검증은 별도 최소 시험의 AZ-a 방향이며 이 양방향 통합판은 재시험 전입니다.
nat_autofailover_enabled = true
# 기존 public/app/DB와 겹치지 않는 VPC 내부 회복 검사 서브넷
nat_health_subnet_cidrs = ["10.42.31.0/24", "10.42.32.0/24"]
