# Git 저장소 루트가 C:\aws-msa-backend-terraform일 때 사용하는 GitHub Actions 템플릿
# 이후 .github/workflows/build-push.yml로 복사하고 AWS_ROLE_TO_ASSUME 변수를 연결
# GitHub OIDC용 AWS 역할은 Terraform 후속 단계에서 준비하며 정적 키는 사용하지 않음
name: Build and publish app images
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'app/msa/member/src/**'
      - 'app/msa/product/src/**'
      - 'app/msa/ordering/src/**'
      - 'app/msa/apigateway/src/**'
      - 'app/msa/frontend/src/**'
      - 'app/msa/frontend/nginx/**'
      - 'app/msa/**/Dockerfile'
      - 'app/msa/**/build.gradle'
      - 'app/msa/**/settings.gradle'
      - 'app/msa/**/gradle/**'
      - 'app/msa/**/gradlew'
permissions:
  contents: write
  id-token: write
concurrency:
  group: final-app-images
  cancel-in-progress: false
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Check AWS role configuration
        env:
          AWS_ROLE: ${{ vars.AWS_ROLE_TO_ASSUME }}
        run: test -n "$AWS_ROLE"
      - uses: aws-actions/configure-aws-credentials@v6.3.0
        with:
          role-to-assume: ${{ vars.AWS_ROLE_TO_ASSUME }}
          aws-region: ap-northeast-2
          allowed-account-ids: '021158485482'
      - uses: aws-actions/amazon-ecr-login@v2
      - name: Build and push five images
        env:
          IMAGE_TAG: ${{ github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          registry=021158485482.dkr.ecr.ap-northeast-2.amazonaws.com
          for pair in member:member-service product:product-service ordering:ordering-service apigateway:apigateway frontend:frontend-service; do
            folder=${pair%%:*}
            repo=${pair##*:}
            image="$registry/$repo:$IMAGE_TAG"
            docker build --platform linux/amd64 -t "$image" "app/msa/$folder"
            docker push "$image"
          done
      - name: Update deployment image tags
        env:
          IMAGE_TAG: ${{ github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          sed -i "s/^    newTag: .*/    newTag: $IMAGE_TAG/" app/msa/kustomization.yaml
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add app/msa/kustomization.yaml
          if ! git diff --cached --quiet; then
            git commit -m "Update deployment images to $IMAGE_TAG"
            git push
          fi
